#include <bits/stdc++.h>
using namespace std;
 
int main(){
    long long t;
    cin>>t;
    while(t--){
        long long n,k;
        cin>>n>>k;
        long long a[n];
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
        long long ispresent = 0;
        for(int i=0;i<n;i++){
            if(a[i]==k){
                ispresent=1;
                break;
            }
        }
        if(ispresent) cout<<"YES"<<endl;
        else cout<<"NO"<<endl;
    }
    return 0;
}